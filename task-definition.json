{
  "family": "nextjs-ecs-task",
  "executionRoleArn": "arn:aws:iam::953138073651:role/ecsTaskExecutionRole",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "1024",
  "runtimePlatform": {
    "cpuArchitecture": "ARM64",
    "operatingSystemFamily": "LINUX"
  },
  "containerDefinitions": [
    {
      "name": "nextjs-ecs-container",
      "image": "953138073651.dkr.ecr.ap-northeast-2.amazonaws.com/nextjs-ecr:latest",
      "cpu": 448,
      "environment": [
        {
          "name": "BFF_ALLOWED_ORIGINS",
          "value": "https://chaeso-zip.com,http://localhost:3000"
        }
      ],
      "secrets": [
        {
          "name": "SESSION_ENCRYPTION_KEY",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:953138073651:secret:/chaeso-zip/production/SESSION_ENCRYPTION_KEY-qCgSR4"
        },
        {
          "name": "OBSERVABILITY_METRICS_ENABLED",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:953138073651:secret:/chaeso-zip/production/OBSERVABILITY_METRICS_ENABLED-kigcSN"
        }
      ],
      "essential": true,
      "portMappings": [
        {
          "name": "nextjs-ecs-container-3000-tcp",
          "containerPort": 3000,
          "hostPort": 3000,
          "protocol": "tcp",
          "appProtocol": "http"
        }
      ],
      "ulimits": [{ "name": "nofile", "softLimit": 65535, "hardLimit": 65535 }],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/nextjs-ecs-task",
          "awslogs-create-group": "true",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "ecs"
        }
      }
    },
    {
      "name": "alloy",
      "image": "953138073651.dkr.ecr.ap-northeast-2.amazonaws.com/nextjs-ecr:alloy-placeholder",
      "essential": false,
      "cpu": 64,
      "memoryReservation": 128,
      "memory": 256,
      "environment": [
        {
          "name": "GOMEMLIMIT",
          "value": "192MiB"
        }
      ],
      "secrets": [
        {
          "name": "GRAFANA_PROM_URL",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:953138073651:secret:/chaeso-zip/production/GRAFANA_PROM_URL-5c3l7x"
        },
        {
          "name": "GRAFANA_PROM_USER",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:953138073651:secret:/chaeso-zip/production/GRAFANA_PROM_USER-TGzCUf"
        },
        {
          "name": "GRAFANA_TOKEN",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:953138073651:secret:/chaeso-zip/production/GRAFANA_TOKEN-YgpYOy"
        }
      ],
      "dependsOn": [
        {
          "containerName": "nextjs-ecs-container",
          "condition": "START"
        }
      ],
      "restartPolicy": {
        "enabled": true,
        "restartAttemptPeriod": 60
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/nextjs-ecs-task",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "alloy",
          "mode": "non-blocking",
          "max-buffer-size": "1m"
        }
      }
    }
  ]
}
