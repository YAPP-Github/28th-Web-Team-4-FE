{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:no-msw": "NEXT_PUBLIC_MSW_ENABLED=false next dev",
    "tokens:build": "node design-tokens/build.mjs",
    "tokens:validate": "node design-tokens/validate.mjs",
    "tokens": "node --run tokens:build && node --run tokens:validate",
    "build": "node --run tokens:build && next build",
    "start": "next start",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --fix-suggestions",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest",
    "test:ci": "vitest --run",
    "test:coverage": "vitest --run --coverage --project unit",
    "test:ui": "vitest --ui",
    "skills:sync": "bash scripts/sync-skills.sh"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@next/third-parties": "16.2.6",
    "@sentry/nextjs": "^10.57.0",
    "@tanstack/react-query": "^5.100.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ky": "^2.0.2",
    "motion": "^12.40.0",
    "next": "16.2.6",
    "posthog-js": "^1.396.6",
    "posthog-node": "^5.39.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-error-boundary": "^6.1.2",
    "react-hook-form": "^7.76.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animated": "^2.1.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@playwright/test": "^1.60.0",
    "@storybook/addon-a11y": "^10.4.1",
    "@storybook/addon-docs": "^10.4.1",
    "@storybook/addon-mcp": "^0.6.0",
    "@storybook/addon-vitest": "^10.4.1",
    "@storybook/nextjs-vite": "^10.4.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@tanstack/react-query-devtools": "^5.100.14",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@tokens-studio/sd-transforms": "^2.0.3",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "@vitest/browser-playwright": "4.1.7",
    "@vitest/coverage-v8": "4.1.7",
    "@vitest/ui": "^4.1.7",
    "babel-plugin-react-compiler": "1.0.0",
    "chromatic": "^17.4.1",
    "jsdom": "^29.1.1",
    "lefthook": "^2.1.8",
    "msw": "^2.14.6",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0",
    "oxlint-tsgolint": "^0.23.0",
    "playwright": "^1.60.0",
    "postcss": "^8.5.16",
    "storybook": "^10.4.1",
    "style-dictionary": "^5.5.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.7"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@latest"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": "node --run lint --",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "packageManager": "pnpm@11.4.0",
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
