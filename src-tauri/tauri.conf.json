{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "채소ZIP",
  "version": "0.1.0",
  "identifier": "com.chaeso-zip.desktop",
  "build": {
    "frontendDist": "https://chaeso-zip.com",
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "채소ZIP",
        "width": 1280,
        "height": 820,
        "minWidth": 800,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.png", "icons/icon.icns"],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
