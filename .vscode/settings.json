{
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": false, // disable default behavior
  "editor.codeActionsOnSave": {
    "source.format.oxc": "explicit", // run formatter first
    "source.fixAll.oxc": "explicit" // run lint fixes after
  },
  "css.lint.unknownAtRules": "ignore",
  "doppler.autocomplete.enable": true,
  "doppler.hover.enable": true
}
